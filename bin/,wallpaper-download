#!/usr/bin/env bash
set -euo pipefail

readonly OMARCHY_STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/current"
readonly OMARCHY_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy"
readonly THEME_FILE="$OMARCHY_STATE_DIR/theme.name"

if [[ ! -r "$THEME_FILE" ]]; then
  echo "Could not determine the current Omarchy theme: $THEME_FILE is not readable" >&2
  exit 1
fi

THEME=$(<"$THEME_FILE")
WALLPAPER_DIR="$OMARCHY_CONFIG_DIR/backgrounds/$THEME"
mkdir -p "$WALLPAPER_DIR"

GALLERY_URL=https://peapix.com/bing
FIRST_GALLERY_PAGE=$(curl -fsSL --retry 3 "$GALLERY_URL")
LAST_GALLERY_PAGE=$(
  printf '%s' "$FIRST_GALLERY_PAGE" |
    python3 -c '
import re
import sys

pages = [1, *map(int, re.findall(r"href=\"/bing\?page=(\d+)\"", sys.stdin.read()))]
print(max(pages))
'
)

WALLPAPER_ID=""
while read -r PAGE; do
  if (( PAGE == 1 )); then
    GALLERY_PAGE=$FIRST_GALLERY_PAGE
  else
    GALLERY_PAGE=$(curl -fsSL --retry 3 "$GALLERY_URL?page=$PAGE")
  fi

  while read -r CANDIDATE_ID; do
    if [[ ! -e "$WALLPAPER_DIR/$CANDIDATE_ID.jpg" ]]; then
      WALLPAPER_ID=$CANDIDATE_ID
      break 2
    fi
  done < <(
    printf '%s' "$GALLERY_PAGE" |
      python3 -c '
import random
import re
import sys

wallpaper_ids = sorted(set(re.findall(r"href=\"/bing/(\d+)\"", sys.stdin.read())))
random.shuffle(wallpaper_ids)
print(*wallpaper_ids, sep="\n")
'
  )
done < <(
  python3 -c '
import random
import sys

pages = list(range(1, int(sys.argv[1]) + 1))
random.shuffle(pages)
print(*pages, sep="\n")
' "$LAST_GALLERY_PAGE"
)

if [[ -z "$WALLPAPER_ID" ]]; then
  echo "All Peapix gallery wallpapers have already been downloaded" >&2
  exit 1
fi

IMAGE_URL=$(
  curl -fsSL --retry 3 "https://peapix.com/bing/$WALLPAPER_ID" |
    python3 -c '
import html
import re
import sys

match = re.search(
    r"<div class=\"gallery-item\" data-src=\"([^\"]+)\"",
    sys.stdin.read(),
)
if not match:
    raise SystemExit("Peapix returned no UHD image")
print(html.unescape(match.group(1)))
'
)

WALLPAPER="$WALLPAPER_DIR/$WALLPAPER_ID.jpg"
TEMPORARY_WALLPAPER=$(mktemp "$WALLPAPER_DIR/.$WALLPAPER_ID.XXXXXX")
trap 'rm -f "$TEMPORARY_WALLPAPER"' EXIT

curl -fsSL --retry 3 "$IMAGE_URL" -o "$TEMPORARY_WALLPAPER"
mv "$TEMPORARY_WALLPAPER" "$WALLPAPER"
trap - EXIT

omarchy theme bg set "$WALLPAPER"
printf 'Downloaded and set wallpaper: %s\n' "$WALLPAPER"
